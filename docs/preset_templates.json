{
    "version": "1.0",
    "remark": "系统预置关键词模板（seed 数据），首次启动 alembic 迁移后自动写入 extract_schema 表，is_preset=true",
    "templates": [
        {
            "name": "合同模板",
            "category": "合同类",
            "description": "通用商务合同关键信息提取",
            "fields": [
                {
                    "key": "party_a",
                    "label": "甲方名称",
                    "type": "string",
                    "desc": "合同中甲方（发包方/采购方）的全称"
                },
                {
                    "key": "party_b",
                    "label": "乙方名称",
                    "type": "string",
                    "desc": "合同中乙方（承包方/供应方）的全称"
                },
                {
                    "key": "contract_amount",
                    "label": "合同金额",
                    "type": "number",
                    "desc": "合同总价款，含税总金额，数值型"
                },
                {
                    "key": "sign_date",
                    "label": "签订日期",
                    "type": "date",
                    "desc": "合同签署日期，YYYY-MM-DD"
                },
                {
                    "key": "term",
                    "label": "合同期限",
                    "type": "string",
                    "desc": "履行期限或起止时间，如'2026-01-01至2026-12-31'"
                },
                {
                    "key": "payment_terms",
                    "label": "付款方式",
                    "type": "string",
                    "desc": "付款条件与方式，如'分期付款、预付30%'"
                },
                {
                    "key": "contract_no",
                    "label": "合同编号",
                    "type": "string",
                    "desc": "合同上的编号"
                }
            ]
        },
