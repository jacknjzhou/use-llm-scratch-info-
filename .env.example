# ===== 必填 =====
# LLM API Key 加密主密钥（Fernet，生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
LLM_MASTER_KEY=change-me

# ===== 数据库 / 队列（compose 默认，一般无需改）=====
# POSTGRES_DB=extractor
# POSTGRES_USER=extractor
# POSTGRES_PASSWORD=extractor

# ===== 提取行为 =====
# LLM_CONCURRENCY=5            # 单文件 chunk 并发数
# LLM_MAX_RPS=0                # 全局每秒 LLM 调用上限（Redis 生效），0 = 不限
# OCR_LANG=chi_sim+eng

# ===== 可靠性 / 安全 =====
# UPLOAD_MAX_MB=50             # 单文件上传上限（MB）
# TASK_STALE_MINUTES=30        # running 任务心跳超时判定（分钟），超时视为僵死并恢复
# API_KEY=                     # 设置后所有 /api 请求需携带 X-API-Key 头或 ?api_key= 参数

# ===== 存储（默认本地卷，可选 S3/OSS/MinIO）=====
# STORAGE_BACKEND=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ===== Web 端口 =====
# WEB_PORT=8008
