# ============================================================
# MCP Server 配置
# ============================================================

# 数据库配置（与主服务共享）
DATABASE_URL=postgresql+asyncpg://extractor:extractor@postgres:5432/extractor

# 存储目录
STORAGE_DIR=/app/storage

# API 认证（与主服务保持一致）
API_KEY=

# LLM 配置（复用主服务的 LLM）
LLM_BASE_URL=http://api:8000/v1
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# OCR 语言
OCR_LANG=chi_sim+eng

# 文件大小限制（MB）
UPLOAD_MAX_MB=50

# MCP SSE 服务配置
MCP_HOST=0.0.0.0
MCP_PORT=8080

# MCP 可访问的文件路径（挂载到容器的目录）
MCP_FILE_PATH=./data
